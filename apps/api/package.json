{
  "name": "@checkiq/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -b",
    "start": "node dist/index.js",
    "typecheck": "tsc -b --pretty",
    "lint": "eslint .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:migrate:app": "tsx src/db/migrate.ts",
    "db:seed": "tsx src/db/seed-cli.ts",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:migrate:kit": "drizzle-kit migrate",
    "predev": "npm run build -w @checkiq/contracts",
    "prebuild": "npm run build -w @checkiq/contracts",
    "pretest": "npm run build -w @checkiq/contracts",
    "db:seed:local-accounts": "tsx src/db/seed-local-accounts.ts"
  },
  "dependencies": {
    "@checkiq/contracts": "*",
    "@node-rs/argon2": "^2.2.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "multer": "^2.4.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "resend": "^6.34.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^7.0.4",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^5.0.5"
  }
}
