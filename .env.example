# ---- Application ----
NODE_ENV=development
PORT=4000
HOST=127.0.0.1
LOG_LEVEL=info
TRUST_PROXY=false

# ---- Database (MySQL 8.4) ----
DATABASE_URL=mysql://checkiq:checkiq_dev_pw@127.0.0.1:3306/checkiq
DATABASE_POOL_SIZE=10

# ---- Authentication ----
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=checkiq
JWT_AUDIENCE=checkiq-web
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7

# ---- Sensitive field encryption (AES-256-GCM) ----
PII_ENCRYPTION_KEY=replace-with-32-byte-base64-key
PII_ENCRYPTION_KEY_ID=local-dev-1

# ---- Document storage (private, never publicly served) ----
STORAGE_DIR=./storage
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_MAX_FILES_PER_REQUEST=10

# ---- Web client ----
CORS_ORIGINS=http://localhost:5173
COOKIE_SECURE=false
VITE_API_BASE_URL=http://127.0.0.1:4000

# ---- Email (in-app notifications always work) ----
EMAIL_ENABLED=false
RESEND_API_KEY=  # Set if using Resend for verification emails
EMAIL_FROM=CheckIQ <no-reply@checkiq.org>
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=CheckIQ <no-reply@checkiq.local>

# ---- Support / rate limiting ----
SUPPORT_CONTACT_EMAIL=support@checkiq.local
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_ATTEMPTS=10
SIGNUP_RATE_LIMIT_MAX_ATTEMPTS=5

# ---- Development seed administrator ----
SEED_ADMIN_EMAIL=admin@checkiq.com
SEED_ADMIN_PASSWORD=ChangeMe!2026
SEED_ADMIN_NAME=System Administrator
